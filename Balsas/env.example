# ============================================================================
# .env base para monitorEstanques.py
# Copiar como ".env" en la carpeta del servicio (junto al script y monitor_config.json).
# Se relee en cada ciclo: los cambios aplican sin reiniciar el servicio.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. OBLIGATORIAS: UltraMsg
#    (también se aceptan los nombres antiguos TOKEN, TO y TO_ADMIN)
# ---------------------------------------------------------------------------
API_URL=https://api.ultramsg.com/instanceXXXXX/messages/chat
API_TOKEN=xxxxxxxxxxxxxxxx

# Grupo del cliente: alertas de NIVEL CRÍTICO y POSIBLE REBALSE.
# Obligatoria si el sitio tiene estanques (en Araucarias, que solo vigila conexión, no se usa).
API_TO=120363000000000000@g.us

# Grupo admin: DESCONEXIÓN, RECONEXIÓN, falla de API y reinicios.
# Si falta, esas alertas solo quedan en logs_monitor.txt.
API_TO_ADMIN=120363000000000000@g.us

# ---------------------------------------------------------------------------
# 2. OPCIONALES: umbrales (sobrescriben los de monitor_config.json)
#    Prioridad: NIVEL_ALERTA_<ID> > NIVEL_ALERTA > monitor_config.json
#    <ID> es el "id" del estanque en monitor_config.json, en mayúsculas.
# ---------------------------------------------------------------------------
# Un mismo umbral para todos los estanques del sitio:
# NIVEL_ALERTA=2
# NIVEL_REBALSE=4.25

# Umbral por estanque (ejemplos por sitio):
#   Sitios con un estanque       -> NIVEL_ALERTA_ESTANQUE
#   California                   -> NIVEL_ALERTA_CERRO, NIVEL_ALERTA_METALICO (en %)
#   Hornillas                    -> NIVEL_ALERTA_50, NIVEL_ALERTA_100
#   Los Boldos                   -> NIVEL_ALERTA_1, NIVEL_ALERTA_2
#   Ranguil, González            -> NIVEL_ALERTA_NUEVO, NIVEL_ALERTA_VIEJO
#   Carmen Bajo                  -> NIVEL_ALERTA_POZO, NIVEL_ALERTA_SENTINA (+ NIVEL_REBALSE_*)
#   Idahue                       -> NIVEL_ALERTA_PLANTA1, NIVEL_ALERTA_PLANTA2 (+ NIVEL_REBALSE_*)
#   Bucalemu                     -> NIVEL_ALERTA_BUCALEMU_BAJO, _NILAHUE, _BUCALEMU_ALTO, _CASUTO (+ NIVEL_REBALSE_*)
#   APR El Tambo                 -> NIVEL_ALERTA_SUPERIOR, _INTERMEDIO, _BAJO (en %)
# NIVEL_ALERTA_ESTANQUE=2
# NIVEL_REBALSE_ESTANQUE=4.25

# ---------------------------------------------------------------------------
# 3. OPCIONALES: parámetros (valores por defecto a la derecha)
#    Prioridad: .env > "parametros" de monitor_config.json > valor por defecto
# ---------------------------------------------------------------------------
# Cada cuánto se revisa (min)
# INTERVALO_CHEQUEO_MINUTOS=1
# Cada cuánto se repite una alerta de nivel que sigue activa (min).
# Si no se define, se usa INTERVALO_MINUTOS (nombre antiguo).
# REPETIR_ALERTA_MINUTOS=5
# Alertar nivel crítico aunque el nivel esté estable (true/false)
# ALERTAR_NIVEL_ESTABLE=false

# Minutos sin datos para considerar el equipo desconectado
# UMBRAL_DESCONEXION_MINUTOS=30
# Recordatorio de desconexión en horas (0 = sin recordatorio)
# RECORDATORIO_DESCONEXION_HORAS=24
# Ciclos fallidos seguidos antes de avisar al admin
# UMBRAL_FALLOS_API=5

# Estimación del tiempo de vaciado (regresión lineal)
# VENTANA_VACIADO_MINUTOS=30
# VENTANA_MAXIMA_MINUTOS=120
# MIN_MUESTRAS=5
# MIN_SPAN_MINUTOS=5
# Valor de ?limit= que se pide a la API
# MUESTRAS_MAX=500

# Consulta a la API
# API_TIMEOUT=20
# API_INTENTOS=2

# Solo Windows: servicio a reiniciar al detectar una desconexión nueva (vacío = desactivado)
# REINICIO_SERVICIO_WINDOWS=
# REINICIO_COOLDOWN_MINUTOS=60
