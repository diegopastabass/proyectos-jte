# Copiar a .env y completar. El .env no va a git.
PORT=3041

# PostgreSQL: BD propia "conciliacion" con usuario propio (no el de monitoreo).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=conciliacion
# En RDS va con SSL. Solo para una BD local: DB_SSL=false
DB_SSL=true

# Secreto para firmar los JWT. Generar con: openssl rand -base64 48
JWT_SECRET=

# Carpeta donde se guardan las fotos/PDF de boletas (comprobantes). En la tabla solo queda
# el id y la ruta. Sin la variable se usa ./datos/comprobantes (desarrollo).
COMPROBANTES_DIR=C:\Users\Administrator\Pictures\umploads_consolidacion

# Orígenes permitidos del frontend, separados por coma (ej. https://app.jteanalytics.cl)
CORS_ORIGINS=

# Emisso: lectura automática del RCV y las cartolas (Configuración → Conexiones).
# API key de connect.emisso.ai/api-keys, con los permisos conexiones:read, conexiones:write,
# sii:read, banco_estado:read y bch_empresas:read. Sin ella, la pestaña Conexiones queda inactiva.
EMISSO_API_KEY=
# Orígenes https del front que pueden incrustar la página de Emisso donde se escribe la clave.
# Sin la variable se usan los https de CORS_ORIGINS; sin ninguno, el enlace se abre en otra pestaña.
EMISSO_ORIGENES=https://app.jteanalytics.cl
