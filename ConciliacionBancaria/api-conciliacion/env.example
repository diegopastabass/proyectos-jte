# Copiar a .env y completar. El .env no va a git.
PORT=3041

# PostgreSQL: BD propia "conciliacion" con usuario propio (no el de monitoreo).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=conciliacion
# En RDS va con SSL. Solo para una BD local: DB_SSL=false
DB_SSL=true

# Secreto para firmar los JWT. Generar con: openssl rand -base64 48
JWT_SECRET=

# Orígenes permitidos del frontend, separados por coma (ej. https://app.jteanalytics.cl)
CORS_ORIGINS=
