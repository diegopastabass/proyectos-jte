# ============================================================================
# .env para providerTambo.py y tankService.py (monitor de estanques)
# Copiar como ".env" en la misma carpeta de los scripts. Ambos lo leen.
# ============================================================================

# --- PostgreSQL RDS (obligatorias) ---
DB_HOST=xxxxxxxx.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=
# También se acepta DB_PASSWORD
DB_PASS=
DB_NAME=
# require (por defecto) | verify-full | disable
# DB_SSLMODE=require
# TABLE_NAME=ssr_tambo

# --- MQTT ---
# MQTT_HOST=localhost
# MQTT_PORT=1883
# Solo si mosquitto exige usuario (allow_anonymous false)
# MQTT_USER=
# MQTT_PASS=
# MQTT_QOS=1
# MQTT_CLIENT_ID=providerTambo-<hostname>
# TOPIC=data/TAMBO/COPSET/5203518640151117058

# --- Proceso (valores por defecto) ---
# Cada cuántos segundos se insertan los datos recibidos
# FLUSH_SEGUNDOS=2
# Filas por INSERT
# LOTE_MAX=1000
# Máximo de filas en memoria mientras la BD esté caída (después descarta las más antiguas)
# MAX_PENDIENTES=200000
# Cada cuántos minutos se registra un resumen en el log
# RESUMEN_MINUTOS=15
# Descartar mensajes con el mismo _terminalTime que el anterior
# DESCARTAR_DUPLICADOS=true
# Ignorar el mensaje retenido que entrega el broker al suscribirse
# IGNORAR_RETENIDOS=true
# Variables del payload que no se guardan (además de las que empiezan con "_"), separadas por coma
# CLAVES_EXCLUIDAS=

# --- Alertas UltraMsg al grupo admin (opcionales; sin ellas solo quedan en el log) ---
# API_URL=https://api.ultramsg.com/instanceXXXXX/messages/chat
# API_TOKEN=
# API_TO_ADMIN=120363000000000000@g.us
# NOMBRE_SITIO=SSR Tambo
# UMBRAL_SIN_DATOS_MINUTOS=30
# UMBRAL_FALLA_BD_MINUTOS=10

# --- Monitor de estanques: tankService.py (copia de MonitorEstanques/monitorEstanques.py) ---
# Usa API_URL, API_TOKEN y API_TO_ADMIN de arriba (obligatorios para el monitor: descomentarlos)
# y además el grupo del cliente, que recibe NIVEL CRÍTICO y POSIBLE REBALSE:
# API_TO=120363000000000000@g.us
# Umbrales: por defecto 50 % en monitor_config.json. Override por estanque:
# NIVEL_ALERTA_SUPERIOR=50
# NIVEL_ALERTA_INTERMEDIO=50
# NIVEL_ALERTA_BAJO=50
