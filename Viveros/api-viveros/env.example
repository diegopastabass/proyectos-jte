# api-viveros · variables de entorno (copiar a .env y completar)
NODE_ENV=production
PORT=3005
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
# Obligatoria (mínimo 16 caracteres): sin ella la API no arranca.
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Orígenes permitidos, separados por coma. Por defecto: https://jteanalytics.cl,
# https://www.jteanalytics.cl, https://app.jteanalytics.cl y http://localhost:5173.
# CORS_ORIGINS=
# Solo para pruebas contra un PostgreSQL local sin SSL.
# DB_SSL=false
